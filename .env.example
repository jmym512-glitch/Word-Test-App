# ===================================================
# 환경변수 템플릿 파일 (.env.example)
# 배포 플랫폼(Vercel, Netlify)의 Environment Variables에 등록하거나,
# 로컬 개발 시 이 파일을 복사하여 .env 로 이름을 변경한 뒤 실제 키 값을 입력하세요.
# ===================================================

# 1. SUPABASE 클라우드 데이터베이스 (Project Settings -> API)
VITE_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# 2. 구글 스프레드시트 연동 (Google Apps Script 웹 앱 배포 URL)
VITE_GOOGLE_SHEETS_WEBHOOK_URL="YOUR_GOOGLE_APPS_SCRIPT_WEBHOOK_URL"

# 3. Google Gemini AI API Key (https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
